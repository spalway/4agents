# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_, and
# they are inlined into the client bundle at build time — so these are public
# values, kept here for configurability rather than secrecy. Never put a
# private key or an API secret in this file.

# Token contract address. Leave empty until launch: the UI shows "pending"
# rather than a placeholder that reads as a real address.
VITE_CONTRACT_ADDRESS=

# X handle, with or without the leading @.
VITE_X_HANDLE=xstartupenv
